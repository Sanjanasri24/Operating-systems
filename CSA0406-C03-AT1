4.Implement a program to simulate the working of a Translation Lookaside Buffer (TLB).
The program should demonstrate how TLB improves memory access time by calculating
the effective memory access time with and without TLB.

CODE
#include <stdio.h>

int main() {
    float hit, mem = 100, tlb = 20, emat;

    printf("Enter TLB Hit Ratio (0-1): ");
    scanf("%f", &hit);

    emat = hit * (tlb + mem) + (1 - hit) * (tlb + 2 * mem);

    printf("Without TLB = %.0f ns\n", 2 * mem);
    printf("With TLB = %.0f ns\n", emat);

    return 0;
}

OUTPUT
Enter TLB Hit Ratio (0-1): 0.1
Without TLB = 200 ns
With TLB = 210 ns


