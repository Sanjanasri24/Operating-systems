3.Develop a program to simulate a page table. The program should allow the user to input
page table entries and logical addresses, then map them to physical addresses. Clearly
show how page numbers are translated into frame numbers.

CODE
#include <stdio.h>

int main() {
    int pt[5], p, off;

    printf("Enter 5 frame numbers: ");
    for(int i = 0; i < 5; i++)
        scanf("%d", &pt[i]);

    printf("Enter Page Number and Offset: ");
    scanf("%d %d", &p, &off);

    if(p < 5) {
        printf("Page %d -> Frame %d\n", p, pt[p]);
        printf("Physical Address = %d\n", pt[p] * 100 + off);
    } else
        printf("Invalid Page Number");

    return 0;
}

OUTPUT
Enter 5 frame numbers: 2 5 1 4 3
Enter Page Number and Offset: 1 20
Page 1 -> Frame 5
Physical Address = 520


