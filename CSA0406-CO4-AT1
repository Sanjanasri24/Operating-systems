#include <stdio.h>

int main() {
    int disk[100] = {0}, n, f, ch, i, j, count = 0, start = -1;

    printf("Disk blocks: ");
    scanf("%d", &n);
    printf("File size: ");
    scanf("%d", &f);
    printf("1.Contiguous  2.Linked  3.Indexed\nChoice: ");
    scanf("%d", &ch);

    if (f > n) {
        printf("Allocation not possible\n");
        return 0;
    }

    if (ch == 1) {                 // Contiguous
        for (i = 0; i <= n-f; i++) {
            for (j = i; j < i+f && disk[j] == 0; j++);
            if (j == i+f) {
                start = i;
                break;
            }
        }
        if (start == -1)
            printf("Contiguous allocation failed\n");
        else {
            printf("Blocks: ");
            for (i = start; i < start+f; i++)
                printf("%d ", i);
        }
    }

    else if (ch == 2) {            // Linked
        printf("Blocks: ");
        for (i = 0; i < n && count < f; i++)
            if (!disk[i]) {
                disk[i] = 1;
                printf("%d ", i);
                count++;
            }
    }

    else if (ch == 3) {            // Indexed
        if (f + 1 > n)
            printf("Allocation not possible\n");
        else {
            printf("Index block: 0\nBlocks: ");
            for (i = 1; i <= f; i++)
                printf("%d ", i);
        }
    }

    else
        printf("Invalid choice");

    return 0;
}


