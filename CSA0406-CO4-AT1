#include <stdio.h>
#include <stdlib.h>

int main() {
    int q[20], n, h, size, dir, i, j, t, cur, cscan=0, look=0;

    printf("Enter n: ");
    scanf("%d",&n);
    printf("Requests: ");
    for(i=0;i<n;i++) scanf("%d",&q[i]);
    printf("Head, Disk size: ");
    scanf("%d%d",&h,&size);
    printf("Direction (1=Right, 0=Left): ");
    scanf("%d",&dir);

    for(i=0;i<n-1;i++)
        for(j=i+1;j<n;j++)
            if(q[i]>q[j])
                t=q[i],q[i]=q[j],q[j]=t;

    /* C-SCAN */
    cur=h;
    for(i=0;i<n;i++)
        if(dir && q[i]>=h) cscan+=abs(cur-q[i]),cur=q[i];
    cscan+=size-1-cur+size-1;
    cur=0;
    for(i=0;i<n;i++)
        if(dir && q[i]<h) cscan+=abs(cur-q[i]),cur=q[i];

    /* LOOK */
    cur=h;
    for(i=0;i<n;i++)
        if(q[i]>=h) look+=abs(cur-q[i]),cur=q[i];
    for(i=n-1;i>=0;i--)
        if(q[i]<h) look+=abs(cur-q[i]),cur=q[i];

    printf("\nC-SCAN movement = %d",cscan);
    printf("\nLOOK movement = %d",look);
    printf("\nBest: %s\n", cscan<look ? "C-SCAN" : "LOOK");

    return 0;
}


