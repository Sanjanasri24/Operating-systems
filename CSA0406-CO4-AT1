#include <stdio.h>
#include <stdlib.h>

int main() {
    int q[20], n, h, size, i, j, cur, total;
    int done[20], min, p, fcfs, sstf, scan;

    scanf("%d", &n);
    for(i=0;i<n;i++) scanf("%d",&q[i]);
    scanf("%d%d",&h,&size);

    /* FCFS */
    cur=h; total=0;
    printf("FCFS: %d",cur);
    for(i=0;i<n;i++) {
        total+=abs(cur-q[i]); cur=q[i];
        printf(" -> %d",cur);
    }
    fcfs=total;
    printf("\nSeek=%d\n",total);

    /* SSTF */
    for(i=0;i<n;i++) done[i]=0;
    cur=h; total=0;
    printf("SSTF: %d",cur);

    for(i=0;i<n;i++) {
        min=9999;
        for(j=0;j<n;j++)
            if(!done[j] && abs(cur-q[j])<min)
                min=abs(cur-q[j]),p=j;

        done[p]=1;
        total+=min; cur=q[p];
        printf(" -> %d",cur);
    }
    sstf=total;
    printf("\nSeek=%d\n",total);

    /* SCAN */
    cur=h; total=0;
    printf("SCAN: %d -> 0",cur);
    for(i=h-1;i>=0;i--)
        for(j=0;j<n;j++)
            if(q[j]==i) {
                total+=abs(cur-i); cur=i;
                printf(" -> %d",i);
            }

    total+=cur; cur=0;
    for(i=h+1;i<size;i++)
        for(j=0;j<n;j++)
            if(q[j]==i) {
                total+=abs(cur-i); cur=i;
                printf(" -> %d",i);
            }

    scan=total;
    printf("\nSeek=%d\n",scan);

    if(fcfs<=sstf && fcfs<=scan) printf("Best: FCFS");
    else if(sstf<=scan) printf("Best: SSTF");
    else printf("Best: SCAN");

    return 0;
}


