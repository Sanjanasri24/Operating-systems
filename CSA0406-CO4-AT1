#include <stdio.h>

int main() {
    int b[100], n, req, i, count = 0, block;

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    printf("Enter bitmap (0=Free, 1=Allocated):\n");
    for (i = 0; i < n; i++)
        scanf("%d", &b[i]);

    printf("Enter number of blocks to allocate: ");
    scanf("%d", &req);

    for (i = 0; i < n && count < req; i++) {
        if (b[i] == 0) {
            b[i] = 1;
            count++;
        }
    }

    if (count < req)
        printf("Not enough free blocks!\n");
    else {
        printf("Bitmap after allocation: ");
        for (i = 0; i < n; i++)
            printf("%d ", b[i]);
        printf("\n");
    }

    printf("Enter block to deallocate (-1 to stop): ");
    while (1) {
        scanf("%d", &block);
        if (block == -1)
            break;

        if (block >= 0 && block < n)
            b[block] = 0;
        else
            printf("Invalid block!\n");
    }

    printf("Bitmap after deallocation: ");
    for (i = 0; i < n; i++)
        printf("%d ", b[i]);

    return 0;
}


