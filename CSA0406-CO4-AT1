#include <stdio.h>
#include <stdlib.h>

int main() {
    int n,f,a,s,h,q[50],b[50],used[50]={0};
    int i,j,k=0,cur,total=0,min,p;

    printf("Enter blocks, file size: ");
    scanf("%d%d",&n,&f);

    printf("Allocation (1-Contiguous, 2-Indexed): ");
    scanf("%d",&a);

    printf("Enter request count: ");
    scanf("%d",&s);
    printf("Enter request queue: ");
    for(i=0;i<s;i++) scanf("%d",&q[i]);

    printf("Enter head position: ");
    scanf("%d",&h);

    /* Allocation */
    if(a==1) {
        for(i=0;i<=n-f;i++) {
            for(j=i;j<i+f && !used[j];j++);
            if(j==i+f) {
                for(j=i;j<i+f;j++) b[k++]=j;
                break;
            }
        }
    } else {
        for(i=0;i<n && k<f;i++)
            if(!used[i]) b[k++]=i;
    }

    if(k<f) {
        printf("Allocation failed!");
        return 0;
    }

    printf("Allocated: ");
    for(i=0;i<f;i++) printf("%d ",b[i]);

    printf("\nScheduling (1-FCFS, 2-SSTF): ");
    scanf("%d",&a);

    cur=h;
    printf("Seek sequence: %d",cur);

    if(a==1) {
        for(i=0;i<f;i++) {
            total+=abs(cur-b[i]);
            cur=b[i];
            printf(" -> %d",cur);
        }
    } else {
        for(i=0;i<f;i++) {
            min=9999;
            for(j=0;j<f;j++)
                if(!used[j] && abs(cur-b[j])<min)
                    min=abs(cur-b[j]),p=j;
            used[p]=1;
            total+=min;
            cur=b[p];
            printf(" -> %d",cur);
        }
    }

    printf("\nTotal seek time: %d",total);
    printf("\nBest scheduling: %s",a==1?"FCFS":"SSTF");

    return 0;
}
